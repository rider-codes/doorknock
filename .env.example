# Copy to backend/.env (or .env here) and fill in.

# ---- AI keys: set at least one ------------------------------------------------
# OpenRouter: ONE key for many models, and a different model for each job (see below).
OPENROUTER_API_KEY=
# Anthropic directly (used if you only set this, or for any model id without a "/")
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Hard stop for tokens per day (input + output)
DAILY_TOKEN_CAP=2000000

# ---- which model does which job ------------------------------------------------
# With OPENROUTER_API_KEY set, these are the defaults. Uncomment a line to change one.
# Each is a comma-separated chain: the first model is tried first, the next only if it
# is rate-limited, down, or returns something unusable.
# A model id with a "/" goes through OpenRouter; one without (claude-...) goes to Anthropic.
#
# Read the resume: free first. Note: free models on OpenRouter may log prompts, and your resume is personal
# data. For privacy use a paid model here, e.g. openai/gpt-oss-120b (about $0.04 per million input tokens).
# MODEL_PARSE=nvidia/nemotron-3-super-120b-a12b:free,openai/gpt-oss-120b
#
# Rank the filtered jobs (the scoring step, many calls, so cheap with a big context):
# MODEL_SCORE=google/gemini-3.1-flash-lite,openai/gpt-oss-120b
#
# Write the email (cheap; every claim is still checked against quotes in code):
# MODEL_DRAFT=deepseek/deepseek-v3.2,openai/gpt-5.4-nano
#
# Choose the right people to contact (small prompt, so a strong model costs cents):
# MODEL_PEOPLE=anthropic/claude-sonnet-5.5,openai/gpt-5.6-terra
#
# The brief chat:
# MODEL_BRIEF=google/gemini-3.1-flash-lite,openai/gpt-oss-120b
#
# One model for everything that has no setting of its own:
# MODEL_DEFAULT=

# ---- Jev (TypeSafe AI): fast relevance check on the filtered jobs ------------------
# Jev answers yes/no questions with a probability instead of writing text, so it is quick and very cheap
# (about $42 per billion input tokens, output is free). Before the scoring model sees a job, Jev rates how close a
# match it is for you (role, skills, level). Jobs below the floor are set aside and shown in the Filtered tab.
# It uses your OPENROUTER_API_KEY above (no waitlist, no separate account), model ~typesafe/jev-latest.
# No OpenRouter key? Set TYPESAFE_API_KEY to call TypeSafe directly. With neither, this step is skipped and every
# ranked job goes straight to scoring.
TYPESAFE_API_KEY=
# 0 to 1. Lower keeps more jobs, higher is stricter.
JEV_MIN_RELEVANCE=0.35
# "~typesafe/jev-latest" always follows TypeSafe's newest Jev, so results can shift when they release one.
# To freeze behaviour, pin a version: JEV_MODEL=typesafe/jev-1.13
# JEV_MODEL=
# JEV_PROVIDER=auto   # auto | openrouter | typesafe

# ---- embeddings for ranking: auto | fastembed | hash ----------------------------
EMBEDDINGS=auto

# ---- people + email verification: hunter | mock | none ----------------------------
PEOPLE_PROVIDER=none
HUNTER_API_KEY=

# ---- Gmail drafts (scope: gmail.compose, create drafts only) ----------------------
# Download an OAuth "Desktop app" client secret from Google Cloud Console.
GOOGLE_CLIENT_SECRET_FILE=data/google_client_secret.json

# Where the SQLite db and tokens live (default: backend/data)
# DOORKNOCK_DATA=

# ---- more jobs: an aggregator for employers that have no public job board ----------------
# Free key from https://developer.adzuna.com (India is supported). Adds local Indian employers to every search.
# Each posting comes as a summary only, and its link goes through Adzuna to the employer.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble: free key from https://jooble.org/api/about (500 requests in total). Doorknock spends at most JOOBLE_DAILY_REQUESTS a day
# and stops at JOOBLE_TOTAL_LIMIT, so automatic refreshes cannot use the key up.
JOOBLE_API_KEY=
JOOBLE_DAILY_REQUESTS=40
JOOBLE_TOTAL_LIMIT=480

# ---- keep the list fresh -------------------------------------------------------------------
# While the app is running it re-reads the job boards by itself when the last read is older than this many hours,
# so the newest postings are always at the top. 0 turns it off (then press "Refresh jobs").
AUTO_REFRESH_HOURS=6

# ---- job portals read like a visitor (Internshala, Unstop, Instahyre, Foundit, The Muse, Remotive) ----
# Comma-separated list to read; empty turns them all off. Naukri and Wellfound are not read: they block plain requests.
PORTAL_SOURCES=internshala,unstop,instahyre,foundit,muse,remotive

# ---- the public, bring-your-own-key site (this branch) ----------------------------------------
# PUBLIC_MODE=1 gives every visitor a private workspace, ignores the keys above, and turns off Gmail, portals and auto-refresh.
PUBLIC_MODE=0
WORKSPACE_DAYS=7
MAX_WORKSPACES=300
PUBLIC_RUN_COOLDOWN_SECONDS=300
